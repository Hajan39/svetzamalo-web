---
import BookOrderForm from "@/components/marketing/BookOrderForm.astro";
import Layout from "@/layouts/Layout.astro";
import {
	getFreeEbookTitle,
	getPaidBookDescription,
	getPaidBookTitle,
	isFreeEbookEnabled,
} from "@/lib/bookConfig";
import { fetchSiteConfig } from "@/lib/content/api";
import { SHOP } from "@/lib/shopConfig";
import { translations } from "@/i18n/translations";
import { getLangFromUrl, withLocalePath } from "@/i18n/utils";

const locale = getLangFromUrl(Astro.url);
let siteConfig = await fetchSiteConfig(locale);
if (locale === "en" && !siteConfig) siteConfig = await fetchSiteConfig("cs");

const price = siteConfig?.bookPrice || siteConfig?.bookBankAmount || null;
const paidBookTitle = getPaidBookTitle(siteConfig) || "Kompletní cestovatelský průvodce";
const paidBookDescription = getPaidBookDescription(siteConfig);
const freeEbookTitle = getFreeEbookTitle(siteConfig);
const freeEbookAvailable = isFreeEbookEnabled(siteConfig);
const text = translations[locale].pages.book;
const about = translations[locale].pages.about;

const topics = [
	{
		heading: "Plánování bez cestovky",
		body: "Výběr destinace krok za krokem, tvorba trasy a jak naplánovat, co v zemi vidět.",
	},
	{
		heading: "Dokumenty a vstup do země",
		body: "Pas, víza, povolená délka pobytu a co se stane, pokud v zemi zůstanete déle.",
	},
	{
		heading: "Zdraví, bezpečnost a pojištění",
		body: "Nemoci, zranění, dostupnost péče, léky, očkování. Jak vybrat pojištění a co dělat při pojistné události.",
	},
	{
		heading: "Peníze a platební karty",
		body: "Karty bez poplatků, výběry z bankomatů v zahraničí a jak na směnu – jakou měnu vzít a kde.",
	},
	{
		heading: "Letecká doprava a letenky",
		body: "Skryté triky na levné letenky, vyhledávače, nízkonákladovky, chybné tarify, zavazadla a letištní proces.",
	},
	{
		heading: "Ubytování a stravování",
		body: "Jak ušetřit na ubytování – nebo jak za něj neplatit vůbec. Stravování v Evropě i tropech.",
	},
	{
		heading: "Balení, jazyk a mobilní tarif",
		body: "Co balit a co ne, překonání jazykové bariéry, mobilní tarify, eSIM a top offline aplikace.",
	},
	{
		heading: "Pokročilé cestování",
		body: "Luxusní destinace bez luxusního rozpočtu, práce na cestách a parťák versus sólo cestování.",
	},
];

// Qualifying the reader is part of selling: someone who recognises themselves
// buys, and someone who does not is spared a refund request. Both lists are
// drawn from what the book actually covers above, not invented.
const forWho = [
	"Chystáš první cestu mimo Evropu a nechceš platit cestovce za to, co zvládneš sám.",
	"Cestuješ pravidelně, ale máš pocit, že za letenky a ubytování dáváš víc, než je nutné.",
	"Chceš mít před odletem jistotu v dokumentech, pojištění a penězích, ne dohledávat to na fórech.",
	"Plánuješ delší cestu nebo práci na cestách a potřebuješ postup, ne jednotlivé tipy.",
];

const notForWho = [
	"Hledáš konkrétní itinerář na jednu destinaci — na to jsou články a průvodci na tomhle webu, zdarma.",
	"Chceš all-inclusive dovolenou bez plánování. Průvodce je o tom, jak si cestu postavit sám.",
];

const outcomes = [
	{
		heading: "Najdeš letenku za rozumnou cenu",
		body: "Víš, kdy hledat, kde hledat a proč je stejný let jednou za třetinu ceny. Včetně chybných tarifů a nízkonákladovek.",
	},
	{
		heading: "Vyřešíš dokumenty bez nervů",
		body: "Pas, víza, délka pobytu, co dělat při problému na hranici. Bez dohadování na fórech den před odletem.",
	},
	{
		heading: "Nepřeplatíš za peníze samotné",
		body: "Karty bez poplatků, výběry v zahraničí, správná měna. Nejtišší způsob, jak na cestě utratit navíc.",
	},
	{
		heading: "Sbalíš se a zůstaneš online",
		body: "Co s sebou a co ne, eSIM a mobilní tarify, offline aplikace, které opravdu použiješ.",
	},
];

// Answers are limited to what is actually true of this shop and this file —
// no invented guarantees, no promises about future updates.
const faq = [
	{
		q: "Jak a kdy knihu dostanu?",
		a: "Při platbě kartou přijde odkaz ke stažení e-mailem hned po zaplacení. Při platbě převodem ti pošleme e-mailem částku a variabilní symbol, a odkaz odejde, jakmile platba dorazí — obvykle do jednoho pracovního dne.",
	},
	{
		q: "V jakém formátu kniha je?",
		a: "PDF. Otevřeš ji v mobilu, na tabletu i v počítači, a po stažení ji máš k dispozici i offline na cestě.",
	},
	{
		q: "Je to pro začátečníky, nebo i pro zkušené cestovatele?",
		a: "Pro obojí. Průvodce začíná plánováním a dokumenty, ale má i kapitoly o pokročilém cestování — luxusních destinacích za rozumné peníze a práci na cestách.",
	},
	{
		q: "Čím se to liší od článků na webu, které jsou zdarma?",
		a: "Články řeší jednotlivé destinace a dílčí témata. Průvodce je celý postup pohromadě a v pořadí, v jakém cestu opravdu plánuješ — od rozhodnutí kam až po návrat.",
	},
	{
		q: "Co když mi průvodce nesedne?",
		a: "Napiš do 14 dnů od nákupu a peníze vrátíme. Bez dotazníku a bez dohadování — stačí e-mail nebo variabilní symbol z potvrzení.",
	},
	{
		q: "Co když mi kniha nepřijde?",
		a: "Napiš nám a odkaz pošleme znovu. Objednávku máme uloženou, takže stačí uvést e-mail nebo variabilní symbol z potvrzení.",
	},
];

const pagePath = withLocalePath("/book/kompletni-pruvodce", locale);
const pageUrl = `${SHOP.siteUrl}${pagePath}`;
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Book",
			name: paidBookTitle,
			description: paidBookDescription,
			url: pageUrl,
			inLanguage: "cs-CZ",
			bookFormat: "https://schema.org/EBook",
			numberOfPages: 230,
			...(siteConfig?.bookCover ? { image: siteConfig.bookCover.src } : {}),
			author: { "@type": "Person", name: SHOP.sellerName, url: `${SHOP.siteUrl}/about` },
			publisher: { "@type": "Organization", name: "Svět za málo", url: SHOP.siteUrl },
			offers: {
				"@type": "Offer",
				price: String(price || SHOP.priceCzk),
				priceCurrency: "CZK",
				availability: "https://schema.org/InStock",
				url: `${pageUrl}#objednat`,
				seller: { "@type": "Person", name: SHOP.sellerName },
			},
		},
		{
			"@type": "FAQPage",
			mainEntity: faq.map((item) => ({
				"@type": "Question",
				name: item.q,
				acceptedAnswer: { "@type": "Answer", text: item.a },
			})),
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Svět za málo", item: SHOP.siteUrl },
				{ "@type": "ListItem", position: 2, name: "Ebook", item: `${SHOP.siteUrl}${withLocalePath("/book", locale)}` },
				{ "@type": "ListItem", position: 3, name: paidBookTitle, item: pageUrl },
			],
		},
	],
};
---

<Layout
	title={`Kompletní cestovatelský průvodce – Levně a chytře do celého světa | Svět za málo`}
	description="Průvodce cestováním na 230+ stranách. Letenky, ubytování, dokumenty, zdraví, peníze a aplikace – vše pro cestování bez zbytečných chyb a výdajů."
	canonicalPath={pagePath}
	image={siteConfig?.bookCover?.src}
	siteConfig={siteConfig}
>
	<Fragment slot="head">
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
	</Fragment>
	<section class="book-guide-hero">
		<div class="container-wide book-guide-hero-inner">
			<div class="book-guide-hero-copy">
				<p class="section-kicker">Průvodce</p>
				<h1>Kompletní cestovatelský průvodce</h1>
				<p class="book-guide-subtitle">Levně a chytře do celého světa</p>
				{paidBookDescription && <p>{paidBookDescription}</p>}
				<ul class="book-guide-stats">
					<li>230+ stran</li>
					<li>40+ kapitol</li>
					{price && <li>{price}</li>}
				</ul>
				<div class="hero-actions">
					<a class="btn-primary" href="#objednat">{text.orderByGateway}</a>
					<a class="btn-secondary" href={withLocalePath('/book', locale)}>{text.downloadFree}</a>
				</div>
			</div>
			{siteConfig?.bookCover && (
				<div class="book-guide-cover">
					<img
						src={siteConfig.bookCover.src}
						alt={siteConfig.bookCover.alt || paidBookTitle}
						width={siteConfig.bookCover.width ?? 300}
						height={siteConfig.bookCover.height ?? 424}
						loading="eager"
						decoding="async"
					/>
				</div>
			)}
		</div>
	</section>

	<section class="container-wide sales-block">
		<div class="section-heading-row">
			<div>
				<p class="section-kicker">Po přečtení</p>
				<h2>Co budeš umět</h2>
			</div>
		</div>
		<div class="sales-outcomes">
			{outcomes.map((item) => (
				<div class="sales-outcome">
					<strong>{item.heading}</strong>
					<p>{item.body}</p>
				</div>
			))}
		</div>
	</section>

	<section class="container-wide book-guide-topics">
		<div class="section-heading-row">
			<div>
				<p class="section-kicker">Co v průvodci najdeš</p>
				<h2>40+ kapitol, vše co potřebuješ vědět</h2>
			</div>
		</div>
		<div class="book-guide-topics-grid">
			{topics.map((topic) => (
				<div class="book-guide-topic-card">
					<strong>{topic.heading}</strong>
					<p>{topic.body}</p>
				</div>
			))}
		</div>
	</section>

	<section class="container-wide sales-block">
		<div class="sales-audience">
			<div class="sales-audience-col">
				<h2>Průvodce je pro tebe, pokud</h2>
				<ul class="sales-list sales-list-yes">
					{forWho.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div class="sales-audience-col">
				<h2>Nekupuj ho, pokud</h2>
				<ul class="sales-list sales-list-no">
					{notForWho.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="container-wide sales-block">
		<div class="sales-author">
			<div>
				<p class="section-kicker">Kdo to psal</p>
				<h2>{SHOP.sellerName}</h2>
				<p>Za webem Svět za málo stojí od roku 2020. Cesty po vlastní ose po Evropě, Asii, Americe i Oceánii, a z každé zůstal seznam toho, co příště udělat levněji a chytřeji. Přesně ten seznam je tenhle průvodce.</p>
				<p>O cestování přednáší pro školy, knihovny a cestovatelské kluby — {about.pastEvents.length} besed od roku 2020, témata od Nového Zélandu po Vietnam.</p>
				<a href={withLocalePath('/about', locale)} class="text-link">Víc o projektu a přednáškách →</a>
			</div>
			<div class="sales-guarantee">
				<p class="section-kicker">Garance</p>
				<h3>14 dní na rozmyšlenou</h3>
				<p>Pokud ti průvodce do 14 dnů od nákupu nepomůže, napiš a peníze vrátíme. Bez otázek.</p>
			</div>
		</div>
	</section>

	<section class="container-wide book-guide-order" id="objednat">
		<div class="book-guide-order-inner">
			<div class="book-guide-order-copy">
				<p class="section-kicker">{text.wantMore}</p>
				<h2>{paidBookTitle}</h2>
				{price && <p class="book-guide-price">{text.priceLabel}: <strong>{price}</strong></p>}
			</div>
			<BookOrderForm siteConfig={siteConfig} id="guide-order" class="book-guide-order-form" />
		</div>
	</section>

	<div class="container-wide sales-trust">
		<ul>
			<li><strong>Doručení e-mailem</strong><span>Kartou hned po zaplacení, převodem po přijetí platby.</span></li>
			<li><strong>Platba přes ComGate</strong><span>Kartou nebo bankovním převodem.</span></li>
			<li><strong>Garance 14 dní</strong><span>Nesedne? Napiš a peníze vrátíme.</span></li>
			<li><strong>Prodejce</strong><span>{SHOP.sellerName}, IČO {SHOP.sellerIco}</span></li>
		</ul>
		<p>
			<a href={withLocalePath('/dodaci-podminky', locale)}>Dodání a platba</a>
			<a href={withLocalePath('/reklamace', locale)}>Reklamace</a>
			<a href={withLocalePath('/terms', locale)}>Podmínky</a>
		</p>
	</div>

	<section class="container-wide sales-block">
		<div class="section-heading-row">
			<div>
				<p class="section-kicker">Než koupíš</p>
				<h2>Časté otázky</h2>
			</div>
		</div>
		<div class="sales-faq">
			{faq.map((item) => (
				<details>
					<summary>{item.q}</summary>
					<p>{item.a}</p>
				</details>
			))}
		</div>
	</section>

	<section class="container-wide book-guide-order" id="objednat-2">
		<div class="book-guide-order-inner">
			<div class="book-guide-order-copy">
				<p class="section-kicker">Připraveno?</p>
				<h2>{paidBookTitle}</h2>
				{price && <p class="book-guide-price">{text.priceLabel}: <strong>{price}</strong> · PDF hned po zaplacení · garance 14 dní</p>}
			</div>
			<BookOrderForm siteConfig={siteConfig} id="guide-order-2" class="book-guide-order-form" />
		</div>
	</section>

	<div class="buy-bar">
		<span><strong>{price}</strong> · PDF, garance 14 dní</span>
		<a class="btn-primary" href="#objednat">Koupit</a>
	</div>

	{freeEbookAvailable && (
		<div class="container-wide book-guide-free-note">
			<p>{text.goodStart}: <a href={withLocalePath('/book', locale)} class="text-link">{freeEbookTitle} — {text.downloadFree}</a></p>
		</div>
	)}
</Layout>

<style>
	.sales-block { padding-block: clamp(2.5rem, 6vw, 4rem); }

	.sales-author {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 2rem;
		align-items: start;
	}

	.sales-author p { color: var(--foreground-secondary); }

	.sales-guarantee {
		border: 1px solid var(--border);
		border-top: 4px solid var(--primary);
		border-radius: var(--radius);
		background: var(--background-secondary);
		padding: 1.5rem 1.6rem;
	}

	.sales-guarantee h3 { margin: 0.2rem 0 0.5rem; }

	/* Mobile-only sticky buy bar, parked above the bottom navigation. */
	.buy-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
		z-index: 30;
		display: none;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 1rem;
		border-top: 1px solid var(--border);
		background: var(--background);
		box-shadow: 0 -8px 24px rgb(0 0 0 / 0.08);
		font-size: 0.9rem;
	}

	@media (max-width: 767px) {
		.buy-bar { display: flex; }
		.book-guide-free-note { padding-bottom: 4rem; }
		.sales-author { grid-template-columns: 1fr; }
	}

	.sales-outcomes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1rem;
	}

	.sales-outcome {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--background-secondary);
		padding: 1.15rem 1.25rem;
	}

	.sales-outcome strong { display: block; margin-bottom: 0.3rem; }
	.sales-outcome p { margin: 0; color: var(--foreground-secondary); font-size: 0.94rem; }

	.sales-audience {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 1.5rem 2.5rem;
	}

	.sales-audience h2 { font-size: clamp(1.2rem, 2.4vw, 1.5rem); margin-bottom: 0.85rem; }

	.sales-list { display: grid; gap: 0.6rem; margin: 0; padding: 0; list-style: none; }

	.sales-list li {
		position: relative;
		padding-left: 1.75rem;
		color: var(--foreground-secondary);
	}

	/* Drawn marks rather than emoji, so they inherit colour and stay crisp. */
	.sales-list-yes li::before,
	.sales-list-no li::before {
		content: "";
		position: absolute;
		top: 0.42em;
	}

	.sales-list-yes li::before {
		left: 0.3rem;
		width: 0.55rem;
		height: 0.3rem;
		border-left: 2px solid var(--primary);
		border-bottom: 2px solid var(--primary);
		transform: rotate(-45deg);
	}

	.sales-list-no li::before {
		left: 0.35rem;
		width: 0.7rem;
		height: 0;
		border-top: 2px solid var(--foreground-muted);
	}

	.sales-trust {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		margin-top: 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.1rem 1.35rem;
	}

	.sales-trust ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem 2.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sales-trust li { max-width: 17rem; }
	.sales-trust strong { display: block; font-size: 0.9rem; }
	.sales-trust span { color: var(--foreground-muted); font-size: 0.85rem; }

	.sales-trust p {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0;
		font-size: 0.85rem;
	}

	.sales-trust p a { color: var(--primary); }

	.sales-faq { display: grid; gap: 0.6rem; }

	.sales-faq details {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--background-secondary);
		padding: 0.9rem 1.15rem;
	}

	.sales-faq summary {
		cursor: pointer;
		font-weight: 700;
		list-style: none;
	}

	.sales-faq summary::-webkit-details-marker { display: none; }

	.sales-faq summary::after {
		content: "+";
		float: right;
		color: var(--primary);
		font-size: 1.15rem;
		line-height: 1;
	}

	.sales-faq details[open] summary::after { content: "\2212"; }

	.sales-faq p {
		margin: 0.65rem 0 0;
		color: var(--foreground-secondary);
		font-size: 0.95rem;
	}
</style>
