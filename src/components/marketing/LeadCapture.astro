---
interface Props {
  kicker?: string;
  title?: string;
  text?: string;
  source: string;
  leadType?: 'ebook' | 'sample' | 'newsletter' | 'book_notify';
  buttonLabel?: string;
  note?: string;
  successText?: string;
  compact?: boolean;
}

import HoneypotField from '@/components/forms/HoneypotField.astro';
import { translations } from '@/i18n/translations';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const defaults = translations[locale].components.leadCapture;

const {
  kicker = defaults.kicker,
  title = defaults.title,
  text = defaults.text,
  source,
  leadType = 'ebook',
  buttonLabel = defaults.buttonLabel,
  note = defaults.note,
  successText = t('leadCapture.success'),
  compact = false,
} = Astro.props;
---

<section class:list={['lead-capture', compact ? 'lead-capture-compact' : '']}>
  <div>
    <p class="lead-kicker">{kicker}</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <form method="post" action="/api/leads" class="lead-form">
    <input type="hidden" name="leadType" value={leadType} />
    <input type="hidden" name="source" value={source} />
    <HoneypotField id={`hp-lead-${source}`} />
    <label class="sr-only" for={`lead-email-${source}`}>{t('leadCapture.emailLabel')}</label>
    <input id={`lead-email-${source}`} class="form-field" type="email" name="email" placeholder={t('leadCapture.emailPlaceholder')} autocomplete="email" required />
    <button class="btn-primary lead-submit-btn" type="submit">
      <span class="lead-btn-label">{buttonLabel}</span>
      <span class="lead-btn-spinner" aria-hidden="true"></span>
    </button>
    <span class="lead-note">{note}</span>
  </form>
  <p class="lead-success" hidden role="status" aria-live="polite">{successText}</p>
</section>

<style>
  .lead-btn-spinner {
    display: none;
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: lead-spin 0.6s linear infinite;
    flex-shrink: 0;
  }

  .lead-submit-btn[aria-busy="true"] {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    cursor: not-allowed;
    opacity: 0.75;
  }

  .lead-submit-btn[aria-busy="true"] .lead-btn-spinner {
    display: inline-block;
  }

  @keyframes lead-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  // Submits in place so the reader keeps their spot in the article. Without
  // JS (or on any error) the form falls back to the normal POST + redirect.
  document.querySelectorAll('.lead-form').forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    form.addEventListener('submit', async (event) => {
      const btn = form.querySelector('.lead-submit-btn');
      if (btn instanceof HTMLButtonElement) {
        if (btn.disabled) return;
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
      }
      event.preventDefault();
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        const success = form.parentElement?.querySelector('.lead-success');
        if (success instanceof HTMLElement) success.hidden = false;
      } catch {
        form.submit();
      }
    });
  });
</script>
