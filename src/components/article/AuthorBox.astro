---
// Who wrote this: a face and two sentences under every article. Readers (and
// Google's quality raters) trust a named person more than a site name.
import { translations } from "@/i18n/translations";
import { getLangFromUrl, withLocalePath } from "@/i18n/utils";

const locale = getLangFromUrl(Astro.url);
const text = translations[locale].components.authorBox;
---

<aside class="author-box">
	<img src="/images/book/autori.jpg" alt={text.alt} width="1473" height="1106" loading="lazy" decoding="async" />
	<div>
		<p class="author-box-kicker">{text.kicker}</p>
		<h2>Jan a Kateřina Hančovi</h2>
		<p>{text.body}</p>
		<a href={withLocalePath("/about", locale)} class="text-link">{text.link}</a>
	</div>
</aside>

<style>
	.author-box {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 1.25rem;
		align-items: center;
		margin-top: 2rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--background-secondary);
	}

	.author-box img {
		width: 120px;
		height: 120px;
		object-fit: cover;
		border-radius: 50%;
	}

	.author-box-kicker {
		margin: 0 0 0.2rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.author-box h2 {
		margin: 0 0 0.4rem;
		font-size: 1.2rem;
	}

	.author-box p:last-of-type {
		margin: 0 0 0.6rem;
		color: var(--foreground-secondary);
		font-size: 0.95rem;
	}

	@media (max-width: 640px) {
		.author-box {
			grid-template-columns: 1fr;
			text-align: center;
			justify-items: center;
		}
	}
</style>
