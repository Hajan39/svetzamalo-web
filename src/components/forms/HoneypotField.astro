---
// Spam trap: a field humans never see and never fill, so any submission that
// fills it is a bot (see src/lib/spamGuard.ts).
//
// The hiding is done with inline styles on purpose. A honeypot that becomes
// visible when a stylesheet fails to load is worse than no honeypot -- real
// visitors get asked to leave a field empty. Inline styles cannot arrive late
// or get cached separately from the markup.
//
// It must NOT be type="hidden": bots skip those, so it has to look like a real
// text field to them while staying out of reach for people.
interface Props {
	id: string;
}

const { id } = Astro.props;

const HIDDEN =
	"position:absolute!important;left:-9999px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important;opacity:0!important;pointer-events:none!important;";
---

<div style={HIDDEN} aria-hidden="true">
	<label for={id} style={HIDDEN}>Toto pole nevyplňujte</label>
	<input
		id={id}
		style={HIDDEN}
		type="text"
		name="website"
		tabindex="-1"
		autocomplete="off"
	/>
</div>
