# Svet za malo Astro frontend
# Copy to .env for local development. Configure the same values in Vercel for production.

# Public site URL used for canonical URLs, Open Graph URLs and sitemap generation.
SITE_URL=https://svetzamalo.cz
PUBLIC_SITE_URL=https://svetzamalo.cz

# --- Content (Sanity) -------------------------------------------------------
PUBLIC_SANITY_PROJECT_ID=bh335dwp
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-01-01
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server-only Viewer token. Required for Sanity Visual Editing / draft mode.
SANITY_API_READ_TOKEN=
SANITY_API_TOKEN=

# --- Database (Neon Postgres) ----------------------------------------------
# Orders and collected e-mails. Use the POOLED connection string from Neon.
# Run db/schema.sql once in the Neon SQL editor before the first order.
DATABASE_URL=

# --- Transactional e-mail (Resend) -----------------------------------------
# Without these the shop still records orders, but delivery e-mails are not
# sent and the download link has to be copied from /admin.
RESEND_API_KEY=
MAIL_FROM=Svet za malo <info@svetzamalo.cz>

# --- Shop ------------------------------------------------------------------
SELLER_NAME=Jan Hanč
SELLER_ICO=06328229
CONTACT_EMAIL=info@svetzamalo.cz
BOOK_PRICE_CZK=490

# Free ebook: served straight from public/, no token needed.
FREE_EBOOK_TITLE=10 nejdražších cestovatelských chyb
FREE_EBOOK_PATH=/downloads/10-nejdrazsich-cestovatelskych-chyb.pdf

# Paid book: server-only URL of the PDF. Reachable only through a paid order's
# download token, so it must NOT live under public/.
PAID_BOOK_TITLE=Kompletní cestovatelský průvodce
PAID_BOOK_FILE_URL=

# --- Bank transfer ---------------------------------------------------------
# Either the account number or the IBAN is enough to enable bank transfers.
BANK_ACCOUNT=
BANK_CODE=
BANK_IBAN=
BANK_BIC=
BANK_ACCOUNT_NAME=Jan Hanč

# --- Comgate payment gateway ----------------------------------------------
# Merchant ID and secret from the Comgate portal: Integrace > Nastaveni obchodu.
# COMGATE_TEST stays in test mode unless it is exactly "false".
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true

# --- Admin ----------------------------------------------------------------
# Password for /admin. Without it the admin page stays locked.
ADMIN_PASSWORD=

# --- Optional: Ecomail ----------------------------------------------------
# When set, collected e-mails are also pushed to Ecomail and its automation
# (tag "ebook") delivers the free ebook instead of Resend.
ECOMAIL_API_KEY=
ECOMAIL_LIST_ID=
